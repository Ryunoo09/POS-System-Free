// Backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────── Enums ───────────────

enum Role {
  ADMIN
  OWNER
  CASHIER

  @@map("user_role")
}

enum TransactionStatus {
  COMPLETED
  CANCELLED

  @@map("transaction_status")
}

enum PaymentMethod {
  CASH
  QRIS
  DEBIT_CARD
  BANK_TRANSFER

  @@map("payment_method")
}

enum StockMovementType {
  INITIAL_STOCK
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN

  @@map("stock_movement_type")
}

enum StockReferenceType {
  PRODUCT
  TRANSACTION
  MANUAL
  PURCHASE

  @@map("stock_reference_type")
}

enum ShiftStatus {
  OPEN
  CLOSED

  @@map("shift_status")
}

enum CashMovementType {
  CASH_IN
  CASH_OUT

  @@map("cash_movement_type")
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED

  @@map("return_status")
}

enum ReturnAction {
  RESTOCK
  DAMAGED

  @@map("return_action")
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED

  @@map("po_status")
}

// ─────────────── Models ───────────────

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         Role
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  transactions    Transaction[]
  stockMovements  StockMovement[]
  shifts          Shift[]
  cashMovements   CashMovement[]
  returns         ReturnTransaction[]
  auditLogs       AuditLog[]
  purchaseOrders  PurchaseOrder[]
  priceChanges    ProductPriceHistory[]  @relation("PriceChangedBy")
  scheduledPrices ScheduledPriceChange[] @relation("ScheduledPriceCreatedBy")

  @@index([role, isActive])
  @@map("users")
}

model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String   @db.VarChar(50)
  entity    String   @db.VarChar(50)
  entityId  String   @map("entity_id") @db.VarChar(100)
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model Category {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(500)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[]

  @@index([isActive])
  @@map("categories")
}

model Product {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sku          String   @unique @db.VarChar(50)
  barcode      String?  @unique @db.VarChar(50)
  name         String   @db.VarChar(150)
  description  String?
  categoryId   String   @map("category_id") @db.Uuid
  unit         String   @db.VarChar(20)
  costPrice    Decimal  @default(0) @map("cost_price") @db.Decimal(12, 2)
  sellingPrice Decimal  @default(0) @map("selling_price") @db.Decimal(12, 2)
  stock        Int      @default(0)
  minStock     Int      @default(0) @map("min_stock")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  category           Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  transactionItems   TransactionItem[]
  stockMovements     StockMovement[]
  returnItems        ReturnItem[]
  purchaseOrderItems PurchaseOrderItem[]
  priceHistory       ProductPriceHistory[]
  scheduledPrices    ScheduledPriceChange[]

  @@index([categoryId])
  @@index([isActive])
  @@index([name])
  @@map("products")
}

model Transaction {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceNumber    String            @unique @map("invoice_number") @db.VarChar(30)
  idempotencyKey   String            @unique @map("idempotency_key") @db.Uuid
  cashierId        String            @map("cashier_id") @db.Uuid
  status           TransactionStatus @default(COMPLETED)
  subtotal         Decimal           @db.Decimal(12, 2)
  discountAmount   Decimal           @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount        Decimal           @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount      Decimal           @map("total_amount") @db.Decimal(12, 2)
  paymentMethod    PaymentMethod     @map("payment_method")
  paymentReference String?           @map("payment_reference") @db.VarChar(100)
  amountPaid       Decimal           @map("amount_paid") @db.Decimal(12, 2)
  changeAmount     Decimal           @default(0) @map("change_amount") @db.Decimal(12, 2)
  shiftId          String?           @map("shift_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  cashier User                @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  shift   Shift?              @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  items   TransactionItem[]
  returns ReturnTransaction[]

  @@index([createdAt])
  @@index([cashierId, createdAt])
  @@index([shiftId])
  @@index([status, createdAt])
  @@map("transactions")
}

model TransactionItem {
  id                  String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId       String  @map("transaction_id") @db.Uuid
  productId           String  @map("product_id") @db.Uuid
  productNameSnapshot String  @map("product_name_snapshot") @db.VarChar(150)
  productSkuSnapshot  String  @map("product_sku_snapshot") @db.VarChar(50)
  quantity            Int
  unitPrice           Decimal @map("unit_price") @db.Decimal(12, 2)
  unitCost            Decimal @map("unit_cost") @db.Decimal(12, 2)
  discountAmount      Decimal @default(0) @map("discount_amount") @db.Decimal(12, 2)
  subtotal            Decimal @db.Decimal(12, 2)

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([productId])
  @@map("transaction_items")
}

model StockMovement {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId     String             @map("product_id") @db.Uuid
  movementType  StockMovementType  @map("movement_type")
  quantity      Int
  stockBefore   Int                @map("stock_before")
  stockAfter    Int                @map("stock_after")
  referenceType StockReferenceType @map("reference_type")
  referenceId   String?            @map("reference_id") @db.Uuid
  notes         String?            @db.VarChar(255)
  createdById   String             @map("created_by") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy User    @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
  @@index([movementType])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

model Shift {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cashierId      String      @map("cashier_id") @db.Uuid
  status         ShiftStatus @default(OPEN)
  startingCash   Decimal     @map("starting_cash") @db.Decimal(12, 2)
  expectedCash   Decimal?    @map("expected_cash") @db.Decimal(12, 2)
  actualCash     Decimal?    @map("actual_cash") @db.Decimal(12, 2)
  cashDifference Decimal?    @map("cash_difference") @db.Decimal(12, 2)
  differenceNote String?     @map("difference_note") @db.VarChar(255)
  openedAt       DateTime    @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedAt       DateTime?   @map("closed_at") @db.Timestamptz(6)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  cashier       User                @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  transactions  Transaction[]
  cashMovements CashMovement[]
  returns       ReturnTransaction[]

  @@index([cashierId, status])
  @@index([status, openedAt])
  @@map("shifts")
}

model CashMovement {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shiftId     String           @map("shift_id") @db.Uuid
  type        CashMovementType
  amount      Decimal          @db.Decimal(12, 2)
  reason      String           @db.VarChar(255)
  createdById String           @map("created_by") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  shift     Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  createdBy User  @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([shiftId])
  @@index([createdAt])
  @@map("cash_movements")
}

model ReturnTransaction {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  returnNumber  String        @unique @map("return_number") @db.VarChar(30)
  transactionId String        @map("transaction_id") @db.Uuid
  cashierId     String        @map("cashier_id") @db.Uuid
  shiftId       String?       @map("shift_id") @db.Uuid
  status        ReturnStatus  @default(COMPLETED)
  reason        String        @db.VarChar(255)
  refundAmount  Decimal       @map("refund_amount") @db.Decimal(12, 2)
  refundMethod  PaymentMethod @map("refund_method")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  transaction Transaction  @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  cashier     User         @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  shift       Shift?       @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  items       ReturnItem[]

  @@index([transactionId])
  @@index([createdAt])
  @@map("return_transactions")
}

model ReturnItem {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  returnTransactionId String       @map("return_transaction_id") @db.Uuid
  transactionItemId   String       @map("transaction_item_id") @db.Uuid
  productId           String       @map("product_id") @db.Uuid
  quantity            Int
  unitPrice           Decimal      @map("unit_price") @db.Decimal(12, 2)
  subtotal            Decimal      @db.Decimal(12, 2)
  action              ReturnAction @default(RESTOCK)

  returnTransaction ReturnTransaction @relation(fields: [returnTransactionId], references: [id], onDelete: Cascade)
  product           Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([returnTransactionId])
  @@index([productId])
  @@map("return_items")
}

model Supplier {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(150)
  contact   String?  @db.VarChar(100)
  phone     String?  @db.VarChar(30)
  email     String?  @db.VarChar(100)
  address   String?  @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  purchaseOrders PurchaseOrder[]

  @@index([name])
  @@index([isActive])
  @@map("suppliers")
}

model PurchaseOrder {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  poNumber    String              @unique @map("po_number") @db.VarChar(30)
  supplierId  String              @map("supplier_id") @db.Uuid
  status      PurchaseOrderStatus @default(DRAFT)
  totalAmount Decimal             @map("total_amount") @db.Decimal(12, 2)
  notes       String?             @db.VarChar(500)
  orderedAt   DateTime?           @map("ordered_at") @db.Timestamptz(6)
  receivedAt  DateTime?           @map("received_at") @db.Timestamptz(6)
  createdById String              @map("created_by") @db.Uuid
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  supplier  Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items     PurchaseOrderItem[]

  @@index([supplierId])
  @@index([status])
  @@index([createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchaseOrderId String  @map("purchase_order_id") @db.Uuid
  productId       String  @map("product_id") @db.Uuid
  productName     String  @map("product_name") @db.VarChar(150)
  quantity        Int
  costPrice       Decimal @map("cost_price") @db.Decimal(12, 2)
  subtotal        Decimal @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

enum PriceField {
  SELLING_PRICE
  COST_PRICE

  @@map("price_field")
}

enum PriceChangeSource {
  MANUAL
  SCHEDULED
  BULK

  @@map("price_change_source")
}

enum ScheduledPriceStatus {
  SCHEDULED
  APPLIED
  CANCELLED

  @@map("scheduled_price_status")
}

model ProductPriceHistory {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String            @map("product_id") @db.Uuid
  field       PriceField
  oldValue    Decimal           @map("old_value") @db.Decimal(12, 2)
  newValue    Decimal           @map("new_value") @db.Decimal(12, 2)
  source      PriceChangeSource
  reason      String?           @db.VarChar(255)
  changedById String?           @map("changed_by_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  changedBy User?   @relation("PriceChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([source, createdAt])
  @@map("product_price_history")
}

model ScheduledPriceChange {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId     String               @map("product_id") @db.Uuid
  sellingPrice  Decimal              @map("selling_price") @db.Decimal(12, 2)
  effectiveDate DateTime             @map("effective_date") @db.Timestamptz(6)
  status        ScheduledPriceStatus @default(SCHEDULED)
  reason        String               @db.VarChar(255)
  createdById   String               @map("created_by_id") @db.Uuid
  appliedAt     DateTime?            @map("applied_at") @db.Timestamptz(6)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy User    @relation("ScheduledPriceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([status, effectiveDate])
  @@index([productId, status])
  @@map("scheduled_price_changes")
}
