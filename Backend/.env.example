NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://pos_user:change_me@localhost:5432/pos_db?schema=public"
JWT_SECRET="change_me_to_at_least_32_random_characters"
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=12
CORS_ORIGIN=http://localhost:5173
TAX_RATE=0
# Rate limit login: 0 = matikan (mis. saat menjalankan E2E lokal)
LOGIN_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_WINDOW_MS=900000
# Cache Redis: matikan dengan REDIS_ENABLED=false bila Redis tidak tersedia.
# Gunakan 127.0.0.1 (bukan localhost) agar tidak resolve ke IPv6 ::1 di Windows.
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=pos:v1
