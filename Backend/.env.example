NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://pos_user:change_me@localhost:5432/pos_db?schema=public"
JWT_SECRET="change_me_to_at_least_32_random_characters"
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=12
CORS_ORIGIN=http://localhost:5173
TAX_RATE=0
# Rate limit login: 0 = matikan (mis. saat menjalankan E2E lokal)
LOGIN_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_WINDOW_MS=900000
# Cache Redis: matikan dengan REDIS_ENABLED=false bila Redis tidak tersedia.
# Gunakan 127.0.0.1 (bukan localhost) agar tidak resolve ke IPv6 ::1 di Windows.
# Di Vercel serverless, set REDIS_ENABLED=false (tidak ada Redis; fallback ke PostgreSQL).
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=pos:v1
# ── Vercel production overrides ──
# Set these in the Vercel dashboard (Settings → Environment Variables), not in .env:
#   DATABASE_URL   = Neon connection string (e.g. postgresql://...@ep-xxx.ap-southeast-1.aws.neon.tech/pos_db?sslmode=require)
#   JWT_SECRET     = 32+ random chars (openssl rand -hex 32)
#   CORS_ORIGIN    = https://your-project.vercel.app
#   NODE_ENV       = production
#   VERCEL         = true (auto-set by Vercel; no action needed)
