{
  "name": "pos-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:backend": "pnpm --filter @pos/backend dev",
    "dev:frontend": "pnpm --filter @pos/frontend dev",
    "build": "pnpm --filter @pos/frontend build",
    "type-check": "pnpm --filter @pos/frontend type-check",
    "lint": "pnpm -r --if-present lint",
    "format": "pnpm --filter @pos/frontend format",
    "test": "pnpm -r --if-present test",
    "test:unit": "pnpm --filter @pos/frontend test:unit",
    "test:e2e": "pnpm --filter @pos/frontend test:e2e",
    "db:migrate": "pnpm --filter @pos/backend prisma:migrate",
    "db:deploy": "pnpm --filter @pos/backend prisma:deploy",
    "db:reset": "pnpm --filter @pos/backend prisma:reset"
  }
}
